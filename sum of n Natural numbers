import java.util.*;
class Sum 
{
    public static void main(String args[])
    {
        Scanner c = new Scanner(System.in);
        System.out.println("Enter the number:");
        int n = c.nextInt();
        int sum = 0;
        for(int i = 1;i<=n;i++)
        {
            sum = sum+i;
        }
        System.out.print(sum);
    }
}
